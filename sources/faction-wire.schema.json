{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:briarwake:documentation:faction-wire:1",
  "title": "Proposed faction command envelope and durable extensions",
  "description": "Schema validation is not authentication, lease validation, source proof or permission. Payload identity never substitutes authenticated context. Existing non-faction Record_Character fields stay under their existing owner. Backend revisions map to nonnegative native int64 when exposed to Blueprint. SQLite model uses explicitly documented snake_case fixture adapters rather than an implemented transport.",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "ProtocolVersion": {
          "const": 1
        },
        "RequestId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "OperationId": {
          "enum": [
            "character.create",
            "quest.complete-faction",
            "project.contribute-faction",
            "region.cast-preference",
            "transfer.begin",
            "transfer.activate",
            "character.confirm-legacy-faction",
            "realm.apply-faction-policy"
          ]
        },
        "ContentVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "CatalogVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "AvailabilityRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "ExpectedCharacterRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "LeaseEpoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "Payload": {
          "type": "object"
        }
      },
      "required": [
        "ProtocolVersion",
        "RequestId",
        "OperationId",
        "ContentVersion",
        "CatalogVersion",
        "AvailabilityRevision",
        "ExpectedCharacterRevision",
        "LeaseEpoch",
        "Payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "OperationId": {
                "const": "character.create"
              }
            }
          },
          "then": {
            "properties": {
              "Payload": {
                "$ref": "#/$defs/CreateCharacterPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "OperationId": {
                "const": "quest.complete-faction"
              }
            }
          },
          "then": {
            "properties": {
              "Payload": {
                "$ref": "#/$defs/CompleteQuestPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "OperationId": {
                "const": "project.contribute-faction"
              }
            }
          },
          "then": {
            "properties": {
              "Payload": {
                "$ref": "#/$defs/ContributionPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "OperationId": {
                "const": "region.cast-preference"
              }
            }
          },
          "then": {
            "properties": {
              "Payload": {
                "$ref": "#/$defs/BallotPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "OperationId": {
                "const": "transfer.begin"
              }
            }
          },
          "then": {
            "properties": {
              "Payload": {
                "$ref": "#/$defs/BeginTransferPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "OperationId": {
                "const": "transfer.activate"
              }
            }
          },
          "then": {
            "properties": {
              "Payload": {
                "$ref": "#/$defs/ActivateTransferPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "OperationId": {
                "const": "character.confirm-legacy-faction"
              }
            }
          },
          "then": {
            "properties": {
              "Payload": {
                "$ref": "#/$defs/LegacyConfirmationPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "OperationId": {
                "const": "realm.apply-faction-policy"
              }
            }
          },
          "then": {
            "properties": {
              "Payload": {
                "$ref": "#/$defs/RealmPolicyMutationPayload"
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "StableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "CreateCharacterPayload": {
      "type": "object",
      "properties": {
        "Name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24
        },
        "AppearanceIds": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "additionalProperties": {
            "$ref": "#/$defs/StableId"
          }
        },
        "FactionId": {
          "$ref": "#/$defs/StableId"
        },
        "CombatDisciplineId": {
          "$ref": "#/$defs/StableId"
        },
        "VocationId": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "Name",
        "AppearanceIds",
        "FactionId",
        "CombatDisciplineId",
        "VocationId"
      ],
      "additionalProperties": false
    },
    "CompleteQuestPayload": {
      "type": "object",
      "properties": {
        "QuestId": {
          "$ref": "#/$defs/StableId"
        },
        "QuestDefinitionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "BranchId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "CompletionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "QuestId",
        "QuestDefinitionVersion",
        "BranchId",
        "CompletionGeneration"
      ],
      "additionalProperties": false
    },
    "ContributionPayload": {
      "type": "object",
      "properties": {
        "ProjectId": {
          "$ref": "#/$defs/StableId"
        },
        "ProjectGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "ContributionSourceId": {
          "$ref": "#/$defs/StableId"
        },
        "Units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "SourceReceiptId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "ExpectedRegionRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "ProjectId",
        "ProjectGeneration",
        "ContributionSourceId",
        "Units",
        "SourceReceiptId",
        "ExpectedRegionRevision"
      ],
      "additionalProperties": false
    },
    "CharacterFactionExtension": {
      "type": "object",
      "properties": {
        "FactionId": {
          "$ref": "#/$defs/StableId"
        },
        "FactionDefinitionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "SchemaVersion": {
          "const": 3
        },
        "FactionMigrationState": {
          "enum": [
            "Ready",
            "NeedsReview"
          ]
        },
        "Revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "Progression": {
          "type": "object",
          "properties": {
            "FactionStandings": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 3,
                "maxLength": 96,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": -1000,
                "maximum": 1000
              },
              "minProperties": 1
            },
            "OrganizationStandings": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 3,
                "maxLength": 96,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": -1000,
                "maximum": 1000
              },
              "minProperties": 1
            }
          },
          "required": [
            "FactionStandings",
            "OrganizationStandings"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "FactionId",
        "FactionDefinitionVersion",
        "SchemaVersion",
        "FactionMigrationState",
        "Revision",
        "Progression"
      ],
      "additionalProperties": true
    },
    "RealmFactionPolicy": {
      "type": "object",
      "properties": {
        "RealmId": {
          "$ref": "#/$defs/StableId"
        },
        "SchemaVersion": {
          "const": 1
        },
        "PolicyVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "Revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "RelationshipOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "FirstFactionId": {
                "$ref": "#/$defs/StableId"
              },
              "SecondFactionId": {
                "$ref": "#/$defs/StableId"
              },
              "Score": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              }
            },
            "required": [
              "FirstFactionId",
              "SecondFactionId",
              "Score"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1024,
          "uniqueItems": true
        },
        "GuestTreatyIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "AuditReceiptId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "ChangedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "Reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "ChangedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "RealmId",
        "SchemaVersion",
        "PolicyVersion",
        "Revision",
        "RelationshipOverrides",
        "GuestTreatyIds",
        "AuditReceiptId",
        "ChangedBy",
        "Reason",
        "ChangedAt"
      ],
      "additionalProperties": false
    },
    "BallotPayload": {
      "type": "object",
      "properties": {
        "RoundId": {
          "$ref": "#/$defs/StableId"
        },
        "OptionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 96
        },
        "PolicyVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "ExpectedRegionRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "RoundId",
        "OptionId",
        "PolicyVersion",
        "ExpectedRegionRevision"
      ],
      "additionalProperties": false
    },
    "BeginTransferPayload": {
      "type": "object",
      "properties": {
        "GateId": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "GateId"
      ],
      "additionalProperties": false
    },
    "ActivateTransferPayload": {
      "type": "object",
      "properties": {
        "TransferId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "Ticket": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        }
      },
      "required": [
        "TransferId",
        "Ticket"
      ],
      "additionalProperties": false
    },
    "LegacyConfirmationPayload": {
      "type": "object",
      "properties": {
        "MigrationId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "SelectedFactionId": {
          "$ref": "#/$defs/StableId"
        },
        "ExplicitConfirmation": {
          "const": true
        },
        "ExpectedSchemaVersion": {
          "const": 2
        }
      },
      "required": [
        "MigrationId",
        "SelectedFactionId",
        "ExplicitConfirmation",
        "ExpectedSchemaVersion"
      ],
      "additionalProperties": false
    },
    "RealmPolicyMutationPayload": {
      "type": "object",
      "properties": {
        "ExpectedPolicyRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "Reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "NewPolicy": {
          "$ref": "#/$defs/RealmFactionPolicy"
        }
      },
      "required": [
        "ExpectedPolicyRevision",
        "Reason",
        "NewPolicy"
      ],
      "additionalProperties": false
    },
    "LegacyFactionRecovery": {
      "description": "Recovery projection over an unchanged legacy schema2 record. Confirmation migrates once to schema3 Ready; this is not a second character authority.",
      "type": "object",
      "properties": {
        "SchemaVersion": {
          "const": 2
        },
        "FactionId": {
          "type": "null"
        },
        "FactionMigrationState": {
          "const": "NeedsFactionConfirmation"
        }
      },
      "required": [
        "SchemaVersion",
        "FactionId",
        "FactionMigrationState"
      ],
      "additionalProperties": true
    }
  }
}
